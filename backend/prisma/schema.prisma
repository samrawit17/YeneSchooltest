model EnrollmentRequest {
  id             String                  @id @default(cuid())
  schoolId       String
  academicYearId String
  status         EnrollmentRequestStatus @default(PENDING)

  // Student Information
  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime
  gender      String
  faydaNumber String?
  nationality String?

  // Contact Information
  email   String?
  phone   String?
  address String?

  // Previous School Information
  previousSchool      String?
  previousGrade       Int?
  transferCertificate Boolean @default(false)

  // Parent/Guardian Information
  parentFirstName String
  parentLastName  String
  parentPhone     String
  parentEmail     String?
  parentRelation  String

  // Enrollment Preferences
  requestedGrade   Int
  requestedStream  String?
  requestedSection String? // Preferred section (A, B, C)

  // Documents (JSON array of document types)
  documents String? // JSON: { birthCertificate: true, transferCert: false, ... }

  // Approval Information
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  // Auto-allocated after approval
  allocatedClassId     String?
  allocatedSectionId   String?
  allocatedRollNumber  Int?
  allocatedStudentCode String?

  // User account created for this enrollment
  userId String? @unique

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school           School       @relation(map: "enrollment_school_fk", fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(map: "enrollment_academic_year_fk", fields: [academicYearId], references: [id], onDelete: Cascade)
  allocatedClass   Class?       @relation(map: "enrollment_class_fk", fields: [allocatedClassId], references: [id], onDelete: SetNull)
  allocatedSection Section?     @relation(map: "enrollment_section_fk", fields: [allocatedSectionId], references: [id], onDelete: SetNull)
  user             User?        @relation(map: "enrollment_user_fk", fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
  @@index([academicYearId])
  @@index([requestedGrade])
  @@index([email])
  @@index([phone])
}

// New Exam Seating System Models
enum SeatingMode {
  SINGLE_GRADE
  GRADE_RANGE
}

model ExamSeatingPlan {
  id                      String      @id @default(cuid())
  examId                  String?
  examType                String      @default("MID_TERM")
  schoolId                String
  mode                    SeatingMode
  fromGrade               Int
  toGrade                 Int
  examCapacity            Int         @default(30)
  shuffle                 Boolean     @default(true)
  useScoreThresholdFilter Boolean     @default(false)
  scoreThreshold          Int         @default(0)
  createdBy               String
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  exam        Exam?                   @relation(map: "examId_fk_164", fields: [examId], references: [id], onDelete: Cascade)
  school      School                  @relation(map: "schoolId_fk_165", fields: [schoolId], references: [id], onDelete: Cascade)
  creator     User                    @relation(map: "createdBy_fk_166", fields: [createdBy], references: [id])
  assignments ExamSectionAssignment[]

  @@unique([examId, schoolId])
  @@unique([schoolId, examType])
  @@index([schoolId])
  @@index([examId])
  @@index([createdBy])
  @@index([examType])
}

model ExamSectionAssignment {
  id            String   @id @default(cuid())
  seatingPlanId String
  sectionId     String
  createdAt     DateTime @default(now())

  seatingPlan ExamSeatingPlan      @relation(map: "seatingPlanId_fk_167", fields: [seatingPlanId], references: [id], onDelete: Cascade)
  section     Section              @relation(map: "sectionId_fk_168", fields: [sectionId], references: [id], onDelete: Cascade)
  students    ExamSectionStudent[]

  @@unique([seatingPlanId, sectionId])
  @@index([seatingPlanId])
  @@index([sectionId])
}

model ExamSectionStudent {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  orderIndex   Int
  createdAt    DateTime @default(now())

  assignment ExamSectionAssignment @relation(map: "assignmentId_fk_169", fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                  @relation(map: "studentId_fk_170", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([assignmentId, orderIndex])
}

// Unified Content Model - combines Lesson, Homework, and Assignment
enum ContentType {
  LESSON
  HOMEWORK
  ASSIGNMENT
}

model Content {
  id       String      @id @default(cuid())
  schoolId String
  type     ContentType

  // Title & Description (common)
  title        String
  description  String?
  instructions String?

  // Scheduling (common)
  dueDate      DateTime?
  lessonDate   DateTime?
  periodNumber Int?

  // Academic structure
  academicYearId String?
  semesterId     String?
  grade          Int?
  sectionName    String?
  stream         String?

  // Relations
  classId     String?
  sectionId   String?
  subjectId   String?
  teacherId   String?
  createdById String?

  // Curriculum (Lesson-specific)
  objective     String?
  lessonContent String?
  unitNumber    Int?
  topicName     String?
  topicId       String?
  competency    String?
  isExamPrep    Boolean   @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?

  // Grading (Homework/Assignment-specific)
  totalPoints Float?
  maxMarks    Float?
  attachments String?

  // Status & Control
  status   LessonStatus @default(DRAFT)
  isLocked Boolean      @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school            School           @relation(map: "schoolId_fk_171", fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear?    @relation(map: "academicYearId_fk_172", fields: [academicYearId], references: [id], onDelete: Cascade)
  semester          Term?            @relation(map: "semesterId_fk_173", fields: [semesterId], references: [id])
  subject           Subject?         @relation(map: "subjectId_fk_174", fields: [subjectId], references: [id])
  teacher           User?            @relation("ContentTeacher", fields: [teacherId], references: [id])
  createdBy         User?            @relation("ContentCreatedBy", fields: [createdById], references: [id])
  class             Class?           @relation(map: "classId_fk_175", fields: [classId], references: [id])
  section           Section?         @relation(map: "sectionId_fk_176", fields: [sectionId], references: [id])
  syllabusMapping   SyllabusMapping? @relation(map: "syllabusMappingId_fk_177", fields: [syllabusMappingId], references: [id])
  syllabusMappingId String?

  // Submissions (for Homework/Assignment)
  submissions ContentSubmission[]

  // Attachments/Lesson Resources (for Lessons)
  attachmentsNew ContentAttachment[]
  resources      ContentResource[]

  @@index([schoolId, type])
  @@index([schoolId, title])
  @@index([type, grade])
  @@index([subjectId, type])
  @@index([teacherId, type])
  @@index([dueDate])
  @@index([lessonDate])
  @@index([academicYearId])
  @@index([classId])
}

model ContentSubmission {
  id             String           @id @default(cuid())
  contentId      String
  studentId      String
  submittedAt    DateTime?
  submissionUrl  String?
  submissionText String?
  grade          Float?
  feedback       String?
  status         SubmissionStatus @default(PENDING)
  gradedBy       String?
  gradedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  content      Content @relation(map: "contentId_fk_178", fields: [contentId], references: [id], onDelete: Cascade)
  student      User    @relation(map: "studentId_fk_179", fields: [studentId], references: [id], onDelete: Cascade)
  gradedByUser User?   @relation("GradedByUser", fields: [gradedBy], references: [id])

  @@unique([contentId, studentId])
  @@index([contentId])
  @@index([studentId])
  @@index([status])
}

model ContentAttachment {
  id         String   @id @default(cuid())
  contentId  String
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  content    Content  @relation(map: "contentId_fk_180", fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model ContentResource {
  id           String       @id @default(cuid())
  contentId    String
  schoolId     String
  title        String
  description  String?
  resourceType ResourceType
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  isLocked     Boolean      @default(false)
  uploadedBy   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  content      Content      @relation(map: "contentId_fk_181", fields: [contentId], references: [id], onDelete: Cascade)
  school       School       @relation(map: "schoolId_fk_182", fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model SyncConflict {
  id            String   @id @default(cuid())
  schoolId      String
  entity        String
  entityId      String
  conflictType  String
  localData     Json?
  serverData    Json?
  status        String   @default("pending")
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?
  resolution    String?
  resolvedBy    String?

  @@index([schoolId, status])
  @@index([entity, entityId])
}

model SyncLog {
  id         String   @id @default(cuid())
  schoolId   String
  entity     String
  entityId   String
  operation  String
  status     String
  deviceId   String?
  userId     String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
}
