  userId            String?
  name              String
  email             String?
  username          String
  temporaryPassword String
  role              String
  isSent            Boolean   @default(false)
  sentAt            DateTime?
  sentVia           String?
  batchId           String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  school            School    @relation(map: "schoolId_fk_156", fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?     @relation(map: "userId_fk_157", fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([email])
  @@index([isSent])
}

model Communication {
  id          String                @id @default(cuid())
  schoolId    String
  studentId   String
  createdById String
  subject     String
  message     String
  status      CommunicationStatus   @default(OPEN)
  category    CommunicationCategory @default(GENERAL)
  classId     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  class       Class?                @relation(map: "classId_fk_158", fields: [classId], references: [id])
  createdBy   User                  @relation("CommunicationCreator", fields: [createdById], references: [id])
  school      School                @relation(map: "schoolId_fk_159", fields: [schoolId], references: [id], onDelete: Cascade)
  student     User                  @relation("CommunicationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  replies     CommunicationReply[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@index([createdById])
  @@index([classId])
  @@index([status])
  @@index([createdAt])
}

model CommunicationReply {
  id              String        @id @default(cuid())
  communicationId String
  senderId        String
  message         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  communication   Communication @relation(map: "communicationId_fk_160", fields: [communicationId], references: [id], onDelete: Cascade)
  sender          User          @relation("ReplySender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([communicationId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}

// Lesson model replaced with unified Content model
// Old Lesson, Homework, Assignment tables removed - see Content model below

// Syllabus Mapping - Ethiopian MoE curriculum alignment
model SyllabusMapping {
  id         String    @id @default(cuid())
  schoolId   String
  subjectId  String
  grade      Int
  unitNumber Int // e.g., Unit 3
  unitName   String // e.g., "ኃይሎች እና ጉልበት" (Forces and Energy) - Amharic support
  topicName  String?
  topicId    String? // Ethiopian MoE curriculum topic ID
  competency String? // Learning competency
  school     School    @relation(map: "schoolId_fk_161", fields: [schoolId], references: [id], onDelete: Cascade)
  subject    Subject   @relation(map: "subjectId_fk_162", fields: [subjectId], references: [id], onDelete: Cascade)
  contents   Content[]

  @@unique([schoolId, subjectId, grade, unitNumber])
  @@index([schoolId])
  @@index([subjectId])
  @@index([grade])
}

