generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model School {
  id                        String                     @id @default(cuid())
  name                      String
  email                     String                     @unique
  phone                     String?
  address                   String?
  timezone                  String                     @default("UTC")
  logoUrl                   String?
  isActive                  Boolean                    @default(true)
  settings                  String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  enrollmentKey             String?                    @unique
  code                      String?                    @unique
  publicUrlSlug             String                     @unique
  planId                    String?
  plan                      Plan?                      @relation(fields: [planId], references: [id])
  planAssignedAt            DateTime?
  subscriptions             Subscription[]
  academicYears             AcademicYear[]
  announcements             Announcement[]
  attendances               Attendance[]
  attendanceRecords         AttendanceRecord[]
  attendanceSessions        AttendanceSession[]
  classes                   Class[]
  communications            Communication[]
  conversations             Conversation[]
  credentialLogs            CredentialGenerationLog[]
  departments               Department[]
  documents                 Document[]
  enrollments               Enrollment[]
  enrollmentRequests        EnrollmentRequest[]
  assessments               Assessment[]
  assessmentWeights         AssessmentWeight[]
  exams                     Exam[]
  nationalExamResultBatches NationalExamResultBatch[]
  nationalExamResults       NationalExamResult[]
  examSeatingPlans          ExamSeatingPlan[]
  feeStructures             FeeStructure[]
  financeProfiles           FinanceProfile[]
  grades                    Grade[]
  gradeLevels               GradeLevel[]
  gradeScales               GradeScale[]
  gradingComponents         GradingComponent[]
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  parentProfiles            ParentProfile[]
  parentStudents            ParentStudent[]
  payments                  Payment[]
  payrollSalaries           PayrollSalary[]
  payrollRuns               PayrollRun[]
  payrollEntries            PayrollEntry[]
  pendingCredentials        PendingCredential[]
  receipts                  Receipt[]
  reportCards               ReportCard[]
  promotionRecords          PromotionRecord[]
  schoolEvents              SchoolEvent[]
  studentClasses            StudentClass[]
  studentFees               StudentFee[]
  studentProfiles           StudentProfile[]
  subjects                  Subject[]
  subjectGrades             SubjectGrade[]
  syllabusMappings          SyllabusMapping[]
  teacherProfiles           TeacherProfile[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableSlots            TimetableSlot[]
  users                     User[]
  schoolSettings            SchoolSetting[]
  translationCaches         TranslationCache[]
  DiscountPolicy            DiscountPolicy[]
  SchoolSettings            SchoolSettings?
  contents                  Content[]
  contentResources          ContentResource[]
  DisciplineIncident        DisciplineIncident[]
  periodTimes               PeriodTime[]
  sirenSchedules            SirenSchedule[]
  sirenEvents               SirenEvent[]
  sirenHardwareConfig       SirenHardwareConfig?
  templates                 Template[]
  practiceExams             PracticeExam[]
  practiceExamQuestions     PracticeExamQuestion[]
  practiceExamAttempts      PracticeExamAttempt[]
  practiceExamAnswers       PracticeExamAnswer[]
}

enum PracticeExamStatus {
  DRAFT
  READY
  ACTIVE
  ARCHIVED
}

enum PracticeExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum PracticeExamOption {
  A
  B
  C
  D
}

enum PracticeExamQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

model PracticeExam {
  id               String                 @id @default(cuid())
  schoolId         String
  title            String
  description      String?
  grade            Int
  stream           String?
  classId          String?
  sectionId        String?
  subjectId        String?
  accessCode       String
  durationMinutes  Int                    @default(60)
  passMark         Int                    @default(50)
  status           PracticeExamStatus     @default(DRAFT)
  shuffleQuestions Boolean                @default(true)
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("PracticeExamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  subject          Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions        PracticeExamQuestion[]
  attempts         PracticeExamAttempt[]

  @@index([schoolId, grade, stream])
  @@index([schoolId, status])
  @@index([createdById])
}

model PracticeExamQuestion {
  id            String               @id @default(cuid())
  examId        String
  schoolId      String
  subject       String
  questionType  PracticeExamQuestionType @default(MCQ)
  questionText  String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption PracticeExamOption?
  correctText   String?
  caseSensitive Boolean              @default(false)
  order         Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  exam          PracticeExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  answers       PracticeExamAnswer[]

  @@index([examId])
  @@index([schoolId, subject])
}

model PracticeExamAttempt {
  id           String                    @id @default(cuid())
  examId       String
  schoolId     String
  studentId    String
  status       PracticeExamAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime                  @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  score        Int?
  percentage   Float?
  correctCount Int                       @default(0)
  wrongCount   Int                       @default(0)
  skippedCount Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  exam         PracticeExam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      User                      @relation("PracticeExamStudent", fields: [studentId], references: [id], onDelete: Cascade)
  answers      PracticeExamAnswer[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([schoolId, status])
}

model PracticeExamAnswer {
  id             String               @id @default(cuid())
  attemptId      String
  examId         String
  schoolId       String
  studentId      String
  questionId     String
  selectedOption PracticeExamOption?
  textAnswer     String?
  isFlagged      Boolean              @default(false)
  isCorrect      Boolean?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attempt        PracticeExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PracticeExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([examId, studentId])
  @@index([attemptId])
  @@index([questionId])
}

model Template {
  id            String               @id @default(cuid())
  schoolId      String
  type          DocumentTemplateType
  name          String
  backgroundUrl String
  fieldMapJson  String?
  isActive      Boolean              @default(false)
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, type])
  @@index([schoolId, isActive])
  @@index([createdById])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model TranslationCache {
  id                 String    @id @default(cuid())
  schoolId           String?
  provider           String
  sourceLanguage     String
  targetLanguage     String
  textHash           String
  translatedText     String
  reviewedText       String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, provider, sourceLanguage, targetLanguage, textHash])
  @@index([schoolId, targetLanguage])
  @@map("translation_caches")
}

enum PlanTier {
  CORE
  STANDARD
  ULTIMATE
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  tier          PlanTier       @unique
  description   String?
  features      String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  schools       School[]
  subscriptions Subscription[]
}

model Subscription {
  id        String    @id @default(cuid())
  schoolId  String
  planId    String
  status    String    @default("ACTIVE")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@unique([schoolId])
  @@index([schoolId])
  @@index([planId])
}

model SchoolSetting {
  id        String   @id @default(cuid())
  schoolId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  school    School   @relation(map: "schoolId_fk_1", fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("school_settings")
}

model SchoolSettings {
  id                    String       @id @default(cuid())
  schoolId              String       @unique
  calendarType          CalendarType @default(GREGORIAN)
  defaultAcademicYearId String?
  assessmentTypes       Json? // Custom assessment types config per school

  school              School        @relation(map: "schoolId_fk_2", fields: [schoolId], references: [id], onDelete: Cascade)
  defaultAcademicYear AcademicYear? @relation("DefaultAcademicYear", fields: [defaultAcademicYearId], references: [id])
}

model SchoolYearCounter {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  studentCount Int      @default(0)
  teacherCount Int      @default(0)
  adminCount   Int      @default(0)
  parentCount  Int      @default(0)
  staffCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, academicYear])
  @@index([schoolId])
}

model User {
  id                          String                     @id @default(cuid())
  email                       String?                    @unique
  password                    String
  name                        String
  role                        Role                       @default(STUDENT)
  isActive                    Boolean                    @default(true)
  phone                       String?
  avatarUrl                   String?
  theme                       ThemePreference            @default(LIGHT)
  lastLoginAt                 DateTime?
  schoolId                    String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  deletedAt                   DateTime?
  deletedById                 String?
  mustChangePassword          Boolean                    @default(true)
  username                    String?                    @unique
  createdAnnouncements        Announcement[]
  recordedAttendances         Attendance[]               @relation("RecordedAttendances")
  studentAttendances          Attendance[]               @relation("StudentAttendances")
  attendanceOverrides         AttendanceRecord[]         @relation("AttendanceOverrides")
  attendanceRecords           AttendanceRecord[]
  attendanceSessions          AttendanceSession[]        @relation("SessionRecordedBy")
  conversationParticipants    ConversationParticipant[]
  messagesSent                Message[]                  @relation("MessageSender")
  messageReads                MessageRead[]
  homeroomClasses             Class[]                    @relation("ClassHomeroomTeacher")
  teacherAssessmentSubjects   AssessmentSubject[]        @relation("TeacherAssessmentSubjects")
  classSubjects               ClassSubject[]
  enrollmentRequest           EnrollmentRequest?
  communicationCreated        Communication[]            @relation("CommunicationCreator")
  communicationStudents       Communication[]            @relation("CommunicationStudent")
  replySender                 CommunicationReply[]       @relation("ReplySender")
  credentialLogs              CredentialGenerationLog[]
  Department                  Department[]
  documents                   Document[]
  enrollments                 Enrollment[]
  examResults                 ExamResult[]
  nationalExamResults         NationalExamResult[]       @relation("NationalExamResultStudent")
  importedNationalExamBatches NationalExamResultBatch[]  @relation("NationalExamBatchImporter")
  createdAssessments          Assessment[]               @relation("CreatedAssessments")
  enteredAssessmentScores     StudentAssessmentScore[]   @relation("EnteredAssessmentScores")
  studentAssessmentScores     StudentAssessmentScore[]
  financeProfile              FinanceProfile?
  Grade                       Grade[]
  gradedExams                 Grade[]                    @relation("GradedExams")
  createdSeatingPlans         ExamSeatingPlan[]
  examSectionStudents         ExamSectionStudent[]
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  pushSubscriptions           PushSubscription[]
  parentProfile               ParentProfile?
  passwordResetTokens         PasswordResetToken[]
  paymentsReceived            Payment[]                  @relation("PaymentReceivedBy")
  payrollCreatedRuns          PayrollRun[]               @relation("PayrollRunCreatedBy")
  payrollApprovedRuns         PayrollRun[]               @relation("PayrollRunApprovedBy")
  payrollPaidRuns             PayrollRun[]               @relation("PayrollRunPaidBy")
  payrollSalaries             PayrollSalary[]            @relation("PayrollSalaryStaff")
  payrollEntries              PayrollEntry[]             @relation("PayrollEntryStaff")
  studentPayments             Payment[]                  @relation("StudentPayments")
  pendingCredentials          PendingCredential[]
  receiptsGenerated           Receipt[]                  @relation("ReceiptGeneratedBy")
  studentReceipts             Receipt[]                  @relation("StudentReceipts")
  generatedReportCards        ReportCard[]               @relation("GeneratedReportCards")
  reportCards                 ReportCard[]
  promotedRecords             PromotionRecord[]          @relation("PromotedStudents")
  promotionHistory            PromotionRecord[]
  createdSchoolEvents         SchoolEvent[]
  homeroomSections            Section[]                  @relation("SectionHomeroomTeacher")
  studentClasses              StudentClass[]
  studentFees                 StudentFee[]
  studentProfile              StudentProfile?
  approvedGrades              SubjectGrade[]             @relation("ApprovedGrades")
  studentGrades               SubjectGrade[]             @relation("StudentGrades")
  teacherGrades               SubjectGrade[]             @relation("TeacherGrades")
  submittedGrades             SubjectGrade[]             @relation("SubmittedGrades")
  gradeChangeLogs             GradeChangeLog[]
  teacherProfile              TeacherProfile?
  teacherAssignments          TeacherSubjectAssignment[]
  timetableSlots              TimetableSlot[]
  school                      School?                    @relation(map: "schoolId_fk_3", fields: [schoolId], references: [id])

  userPermissions          UserPermission[]
  contents                 Content[]             @relation("ContentTeacher")
  createdContents          Content[]             @relation("ContentCreatedBy")
  contentSubmissions       ContentSubmission[]
  gradedContentSubmissions ContentSubmission[]   @relation("GradedByUser")
  DisciplineIncident       DisciplineIncident[]
  templatesCreated         Template[]
  createdPracticeExams     PracticeExam[]        @relation("PracticeExamCreatedBy")
  practiceExamAttempts     PracticeExamAttempt[] @relation("PracticeExamStudent")

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([schoolId, role])
  @@index([schoolId])
  @@index([role])
  @@index([deletedAt])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  module          String
  action          String
  description     String?
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(map: "permissionId_fk_4", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(map: "permissionId_fk_5", fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(map: "userId_fk_6", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId], map: "UserPermission_permissionId_fkey")
}

model GradeLevel {
  id                 String              @id @default(cuid())
  name               String
  level              Int
  schoolId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentSubjects AssessmentSubject[]
  classes            Class[]
  enrollments        Enrollment[]
  school             School              @relation(map: "schoolId_fk_7", fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, level])
  @@index([schoolId])
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  schoolId        String
  status          EnrollmentStatus @default(PENDING)
  academicYear    String
  rejectionReason String?
  documents       String?
  metadata        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  gradeId         String?
  grade           Int?
  gradeLevel      GradeLevel?      @relation(map: "gradeId_fk_8", fields: [gradeId], references: [id])
  school          School           @relation(map: "schoolId_fk_9", fields: [schoolId], references: [id], onDelete: Cascade)
  student         User             @relation(map: "studentId_fk_10", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
  @@index([status])
  @@index([academicYear])
  @@index([gradeId])
  @@index([grade])
  @@index([schoolId, status, academicYear])
  @@index([studentId, academicYear])
  @@index([schoolId, deletedAt])
}

model StudentClass {
  id           String   @id @default(cuid())
  studentId    String
  classId      String
  sectionId    String
  schoolId     String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  class        Class    @relation(map: "classId_fk_11", fields: [classId], references: [id], onDelete: Cascade)
  school       School   @relation(map: "schoolId_fk_12", fields: [schoolId], references: [id], onDelete: Cascade)
  section      Section  @relation(map: "sectionId_fk_13", fields: [sectionId], references: [id], onDelete: Cascade)
  student      User     @relation(map: "studentId_fk_14", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYear])
  @@index([studentId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, academicYear])
}

model StudentProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  schoolId            String
  studentCode         String               @unique
  studentId           String               @unique
  faydaNumber         String?              @unique
  enrollmentStatus    EnrollmentStatus     @default(PENDING)
  academicYear        String?
  className           String?
  stream              String?
  section             String?
  rollNumber          String?
  gender              String?
  address             String?
  phone               String?
  motherName          String?
  motherPhone         String?
  emergencyContact    String?
  medicalInfo         String?
  nationality         String?
  documents           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  deletedById         String?
  parents             ParentStudent[]
  reportCards         ReportCard[]
  school              School               @relation(map: "schoolId_fk_15", fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                 @relation(map: "userId_fk_16", fields: [userId], references: [id], onDelete: Cascade)
  disciplinaryRecords DisciplineIncident[]

  @@index([studentCode])
  @@index([schoolId])
  @@index([enrollmentStatus])
  @@index([schoolId, enrollmentStatus, academicYear])
  @@index([schoolId, className, section, academicYear])
  @@index([schoolId, deletedAt])
}

enum DisciplineSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisciplineStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
}

model DisciplineIncident {
  id           String             @id @default(cuid())
  schoolId     String
  studentId    String
  reportedBy   String
  incidentDate DateTime
  title        String
  description  String
  severity     DisciplineSeverity @default(MEDIUM)
  status       DisciplineStatus   @default(OPEN)
  actionTaken  String?
  outcome      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reporter     User               @relation(fields: [reportedBy], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([severity])
  @@index([status])
}

model ParentProfile {
  id         String          @id @default(cuid())
  userId     String          @unique
  schoolId   String
  address    String?
  phone      String?
  occupation String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  school     School          @relation(map: "schoolId_fk_17", fields: [schoolId], references: [id], onDelete: Cascade)
  user       User            @relation(map: "userId_fk_18", fields: [userId], references: [id], onDelete: Cascade)
  children   ParentStudent[]

  @@index([schoolId], map: "ParentProfile_schoolId_fkey")
}

model ParentStudent {
  id               String         @id @default(cuid())
  parentId         String
  studentId        String
  schoolId         String
  relation         String
  isVerified       Boolean        @default(false)
  isPrimary        Boolean        @default(false)
  emergencyContact Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  parent           ParentProfile  @relation(map: "parentId_fk_19", fields: [parentId], references: [id], onDelete: Cascade)
  school           School         @relation(map: "schoolId_fk_20", fields: [schoolId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(map: "studentId_fk_21", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@unique([schoolId, parentId, studentId])
  @@index([studentId])
  @@index([schoolId])
}

model AcademicYear {
  id                  String                    @id @default(cuid())
  schoolId            String
  name                String
  startDate           DateTime
  endDate             DateTime
  ethiopianYear       Int?
  isActive            Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  curriculumType      CurriculumType            @default(SEMESTER)
  calendarType        CalendarType              @default(ETHIOPIAN)
  school              School                    @relation(map: "schoolId_fk_22", fields: [schoolId], references: [id], onDelete: Cascade)
  defaultForSchools   SchoolSettings[]          @relation("DefaultAcademicYear")
  classes             Class[]
  classSubjects       ClassSubject[]
  assessments         Assessment[]
  feeStructures       FeeStructure[]
  studentFees         StudentFee[]
  terms               Term[]
  enrollmentRequests  EnrollmentRequest[]
  nationalExamBatches NationalExamResultBatch[]
  timetableSlots      TimetableSlot[]
  contents            Content[]
  subjects            Subject[]
  announcements       Announcement[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
}

model Term {
  id               String         @id @default(cuid())
  academicYearId   String
  name             String
  startDate        DateTime
  endDate          DateTime
  order            Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isLocked         Boolean        @default(false)
  percentageWeight Float          @default(0)
  assessments      Assessment[]
  subjectGrades    SubjectGrade[]
  academicYear     AcademicYear   @relation(map: "academicYearId_fk_23", fields: [academicYearId], references: [id], onDelete: Cascade)
  contents         Content[]
  feeStructures    FeeStructure[]
  studentFees      StudentFee[]
  payments         Payment[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@index([order])
}

model Class {
  id                     String                     @id @default(cuid())
  schoolId               String
  academicYearId         String
  name                   String
  section                String
  grade                  Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  gradeId                String?
  homeroomTeacherId      String?
  attendances            Attendance[]
  attendanceSessions     AttendanceSession[]
  academicYear           AcademicYear               @relation(map: "academicYearId_fk_24", fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel             GradeLevel?                @relation(map: "gradeId_fk_25", fields: [gradeId], references: [id])
  homeroomTeacher        User?                      @relation("ClassHomeroomTeacher", map: "class_homeroom_teacher_fk", fields: [homeroomTeacherId], references: [id])
  school                 School                     @relation(map: "schoolId_fk_26", fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentSubjects     AssessmentSubject[]
  ClassSubject           ClassSubject[]
  communications         Communication[]
  exams                  Exam[]
  reportCards            ReportCard[]
  promotionSourceRecords PromotionRecord[]          @relation("PromotionFromClass")
  promotionTargetRecords PromotionRecord[]          @relation("PromotionToClass")
  sections               Section[]
  studentClasses         StudentClass[]
  subjectGrades          SubjectGrade[]
