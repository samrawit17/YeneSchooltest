// Grade Change Log - Audit trail for grade modifications
// Tracks who changed what, when, and what the old/new values were
model GradeChangeLog {
  id          String       @id @default(cuid())
  gradeId     String
  fieldName   String // e.g., 'caScore', 'totalScore', 'status'
  oldValue    String? // Stored as string for flexibility
  newValue    String?
  changedById String
  changedAt   DateTime     @default(now())
  reason      String? // Optional reason for change
  grade       SubjectGrade @relation(map: "gradeId_fk_66", fields: [gradeId], references: [id], onDelete: Cascade)
  changedBy   User         @relation(map: "changedById_fk_67", fields: [changedById], references: [id])

  @@index([gradeId])
  @@index([changedById])
  @@index([changedAt])
}

// Finance Audit Log - Full audit trail for finance operations
model FinanceAuditLog {
  id            String   @id @default(cuid())
  schoolId      String
  userId        String
  action        String // CREATE, UPDATE, DELETE, PAYMENT, GENERATE
  entityType    String // FeeStructure, StudentFee, Payment
  entityId      String
  previousValue String? // JSON string of old values
  newValue      String? // JSON string of new values
  amount        Float? // For payment-related actions
  reference     String? // Receipt number or other reference
  description   String?
  createdAt     DateTime @default(now())

  @@unique([schoolId, userId, action, entityType, entityId, createdAt])
  @@index([schoolId, createdAt], name: "FinanceAuditLog_school_created")
  @@index([entityType, entityId], name: "FinanceAuditLog_entity")
  @@index([userId], name: "FinanceAuditLog_user")
}

